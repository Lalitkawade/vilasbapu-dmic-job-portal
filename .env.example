# ==============================================================================
# DMIC BIDKIN EMPLOYMENT REGISTRATION PORTAL
# Environment Variables Configuration
# ==============================================================================

# Supabase Public API Configuration (Used in frontend client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Server-Only Secret (NEVER expose in frontend bundles or prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-migrations-and-backend

# Configurable MLA Office Branding
VITE_OFFICE_NAME_MR=आमदार विलास भुमरे यांचे कार्यालय
VITE_OFFICE_NAME_EN=MLA Vilas Bhumare Office
VITE_PORTAL_TITLE_MR=डीएमआयसी बिडकीन रोजगार नोंदणी पोर्टल
VITE_PORTAL_TITLE_EN=DMIC Bidkin Employment Registration Portal
VITE_DISTRICT_DEFAULT=Chhatrapati Sambhajinagar
VITE_CONTACT_PHONE=9123456789
VITE_CONTACT_EMAIL=office.vilasbhumare@example.com
VITE_OFFICE_ADDRESS_MR=बिडकीन जनसंपर्क कार्यालय, पैठण रोड, छत्रपती संभाजीनगर
VITE_OFFICE_ADDRESS_EN=Bidkin Public Relations Office, Paithan Road, Chhatrapati Sambhajinagar

# Storage & Upload Limits
VITE_RESUME_MAX_SIZE_BYTES=5242880 # 5 MB
